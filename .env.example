# Copy to .env.local for development. Never commit real values.

# --- Public (inlined into browser JavaScript; nothing secret here) ----------

# Canonical site URL, used for metadata, Open Graph, sitemap, and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact address shown in the footer, FAQ, and legal pages.
NEXT_PUBLIC_CONTACT_EMAIL=hello@resai.example

# --- Server only (never prefix these with NEXT_PUBLIC_) ---------------------

# Supabase project URL: Dashboard → Project Settings → API.
SUPABASE_URL=https://your-project-ref.supabase.co

# Service-role key (or a new-style `sb_secret_…` secret key) from the same page.
# It bypasses RLS, so it must only ever exist on the server.
# Without these two values, the waitlist API returns 503 and the form shows
# an error. It never pretends a signup was saved.
SUPABASE_SERVICE_ROLE_KEY=

# Random secret used to hash IPs and emails for rate limiting.
# Generate one with:  openssl rand -hex 32
RATE_LIMIT_SALT=
